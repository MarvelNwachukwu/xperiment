{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "engine-dist",
    "rootDir": ".",
    "resolveJsonModule": true
  },
  "include": ["*.ts"],
  "exclude": ["*.test.ts", "desktop/**", "engine-dist/**"]
}
